  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:psql": "docker compose exec db sh -c 'psql -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\"'",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:list": "knex migrate:list",
    "migrate:make": "knex migrate:make",
    "seed:run": "knex seed:run",
    "reservations:add": "node scripts/add-reservations.js",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
