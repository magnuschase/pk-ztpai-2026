# Copy to .env (cp .env.example .env) - the values below work for local development
# as they are. Validated at startup by src/config (Zod) - a missing or invalid value
# stops the application with a list of problems.

# PostgreSQL in Docker (docker-compose.yml). 
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=room_booking
POSTGRES_PORT=5434

# postgres:// URL (required) - used when the API runs on the host (pnpm start)
DATABASE_URL=postgres://booking:change-me@localhost:5434/room_booking
# Integration tests (pnpm test:integration) - dropped and recreated on every run,
# the name must end with _test. Default: DATABASE_URL with _test appended to the name.
# TEST_DATABASE_URL=postgres://booking:change-me@localhost:5434/room_booking_test
# 1-65535 (default 3000) - also the host port of the api container
PORT=3000
# knex | memory (default knex)
REPOSITORY_DRIVER=knex

# Required, at least 32 characters - generate one: openssl rand -hex 32
JWT_SECRET=local-dev-only-jwt-secret-change-me-0123456789
# Access token lifetime with a unit: 10s, 15m, 1h, 7d (default 15m)
JWT_EXPIRES_IN=15m

# Base URL of a running API for the scripts in scripts/ (default http://localhost:$PORT)
# API_URL=http://localhost:3000
