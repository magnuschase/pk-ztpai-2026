# Copy to .env and fill in. Validated at startup by src/config (Zod) -
# a missing or invalid value stops the application with a list of problems.

# Local PostgreSQL in Docker (docker-compose.yaml)
POSTGRES_USER=booking
POSTGRES_PASSWORD=change-me
POSTGRES_DB=room_booking
POSTGRES_PORT=5434

# postgres:// URL (required)
DATABASE_URL=postgres://booking:change-me@localhost:5434/room_booking
# 1-65535 (default 3000)
PORT=3000
# knex | memory (default knex)
REPOSITORY_DRIVER=knex

# Required, at least 32 characters - generate one: openssl rand -hex 32
JWT_SECRET=
# Access token lifetime with a unit: 10s, 15m, 1h, 7d (default 15m)
JWT_EXPIRES_IN=15m

# Base URL of a running API for the scripts in scripts/ (default http://localhost:$PORT)
# API_URL=http://localhost:3000
